# PanenLens — environment template. Copy to `.env.local` and fill in your own
# Firebase project's values (Firebase console > Project settings > Your apps).
# `.env.local` is git-ignored. Never commit real values.

# --- Firebase web app config (Project settings > General > SDK setup) ---
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxxxxxxxxxx
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# --- App Check ---
# Local development: create a debug token in the Firebase console
# (App Check > Apps > your web app > Manage debug tokens) and paste it here.
# It is read from the environment only — never hardcode it in source.
VITE_FIREBASE_APPCHECK_DEBUG_TOKEN=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Production: reCAPTCHA v3 site key for App Check (leave empty for local dev
# with a debug token). In production, do NOT set the debug token variable.
VITE_FIREBASE_RECAPTCHA_SITE_KEY=
# Fraud Defense / reCAPTCHA Enterprise site key registered in App Check (production).
# Firebase has retired new reCAPTCHA Classic registrations; Enterprise takes precedence.
VITE_FIREBASE_RECAPTCHA_ENTERPRISE_SITE_KEY=
